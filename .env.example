# ---- PocketBase ----
PB_URL=http://127.0.0.1:8090
# Nên tạo một superuser riêng cho bridge (Dashboard > Settings > Superusers)
PB_SUPERUSER_EMAIL=bridge@example.com
PB_SUPERUSER_PASSWORD=doi-mat-khau-nay

# ---- HTTP nội bộ của bridge (PocketBase gọi vào đây) ----
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3939
# Chuỗi bí mật dùng chung với PocketBase (đặt cùng giá trị ZALO_BRIDGE_SECRET cho PocketBase)
BRIDGE_SECRET=thay-bang-chuoi-ngau-nhien-dai

# ---- Zalo ----
# Lưu cả tin do chính tài khoản gửi (từ điện thoại hoặc từ bridge)
ZALO_SELF_LISTEN=true
# Tự tạo mã QR khi chưa đăng nhập
ZALO_AUTO_QR_LOGIN=true
# Khoảng nghỉ giữa 2 tin gửi đi (ms) - giảm nguy cơ bị khoá tài khoản
ZALO_SEND_DELAY_MS=1500
# Chu kỳ quét hàng đợi gửi tin dự phòng (ms)
OUTBOX_POLL_MS=30000
# In log chi tiết của zca-js
ZALO_LOGGING=false
